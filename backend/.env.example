NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://sentinox:sentinox@localhost:5432/sentinox?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# xAI Grok — get your key at https://console.x.ai
GROK_API_KEY=
# Optional aliases also supported: XAI_API_KEY
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-3-mini
GROK_VISION_MODEL=grok-2-vision-1212
GROK_REASONING_MODEL=grok-3-mini

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

OTP_EXPIRY_MINUTES=10
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

UPLOAD_MAX_BYTES=10485760
CDN_BASE_URL=

RXNORM_API_BASE=https://rxnav.nlm.nih.gov/REST
USDA_FDC_API_KEY=
OPEN_FOOD_FACTS_USER_AGENT=Sentinox/1.0

WORKER_CONCURRENCY=5
WS_PATH=/ws
