generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskLevel {
  SAFE
  CAUTION
  HIGH_RISK
}

enum ScanInputType {
  TEXT
  VOICE
  IMAGE
  PDF
  PRESCRIPTION
}

enum ScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  APPLE
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  sessions      Session[]
  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  otpCodes      OtpCode[]
  scans         Scan[]
  voiceSessions VoiceSession[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
}

model Profile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                 Int?
  gender              String?
  allergies           String[] @default([])
  chronicConditions   String[] @default([])
  currentMedications  String[] @default([])
  dietaryPreferences  String[] @default([])
  region              String?
  languagePreference  String   @default("en")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model OAuthAccount {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   OAuthProvider
  providerId String
  createdAt  DateTime      @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Scan {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputType       ScanInputType
  status          ScanStatus    @default(PENDING)
  rawInput        String?       @db.Text
  normalizedText  String?       @db.Text
  language        String        @default("en")
  storageKey      String?
  mimeType        String?
  riskLevel       RiskLevel?
  metadata        Json?
  errorMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  product         Product?
  analysis        Analysis?
  pipelineSteps   PipelineStep[]

  @@index([userId, createdAt])
  @@index([status])
}

model PipelineStep {
  id        String   @id @default(uuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  step      String
  status    String
  output    Json?
  durationMs Int?
  createdAt DateTime @default(now())

  @@index([scanId])
}

model Product {
  id          String   @id @default(uuid())
  scanId      String   @unique
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  brand       String?
  barcode     String?
  externalIds Json?
  createdAt   DateTime @default(now())

  ingredients IngredientOnProduct[]
}

model Ingredient {
  id          String   @id @default(uuid())
  name        String
  normalized  String   @unique
  casNumber   String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  products    IngredientOnProduct[]
  warnings    Warning[]
  graphFrom   KnowledgeEdge[] @relation("EdgeFrom")
  graphTo     KnowledgeEdge[] @relation("EdgeTo")
}

model IngredientOnProduct {
  productId    String
  ingredientId String
  amount       String?
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

model Analysis {
  id                    String    @id @default(uuid())
  scanId                String    @unique
  scan                  Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  overview              String    @db.Text
  benefits              String[]  @default([])
  sideEffects           String[]  @default([])
  riskFactors           String[]  @default([])
  drugInteractions      String[]  @default([])
  allergyWarnings       String[]  @default([])
  usageInstructions     String?   @db.Text
  toxicityAlerts        String[]  @default([])
  contraindications     String[]  @default([])
  riskLevel             RiskLevel
  riskScore             Float
  simplifiedExplanation String    @db.Text
  childFriendly         String?   @db.Text
  elderlyFriendly       String?   @db.Text
  personalizedNotes     String[]  @default([])
  rawAiResponse         Json?
  createdAt             DateTime  @default(now())

  warnings              Warning[]
  interactions          MedicalInteraction[]
}

model Warning {
  id           String     @id @default(uuid())
  analysisId   String
  analysis     Analysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  severity     String
  title        String
  description  String     @db.Text
  createdAt    DateTime   @default(now())

  @@index([analysisId])
}

model MedicalInteraction {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  substanceA  String
  substanceB  String
  severity    String
  description String   @db.Text
  source      String?
  createdAt   DateTime @default(now())

  @@index([analysisId])
}

model KnowledgeEdge {
  id           String   @id @default(uuid())
  fromId       String
  from         Ingredient @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId         String
  to           Ingredient @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  relationType String
  weight       Float    @default(1)
  metadata     Json?
  createdAt    DateTime @default(now())

  @@unique([fromId, toId, relationType])
  @@index([fromId])
  @@index([toId])
}

model VoiceSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanId       String?
  text         String   @db.Text
  language     String   @default("en")
  audioUrl     String?
  phonemes     Json?
  emotionTags  String[] @default([])
  timingMarkers Json?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

model ProductRecall {
  id          String   @id @default(uuid())
  productName String
  brand       String?
  reason      String   @db.Text
  region      String?
  announcedAt DateTime
  createdAt   DateTime @default(now())

  @@index([productName])
}
